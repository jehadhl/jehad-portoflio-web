{
  "name": "run-robrun-nextjs",
  "version": "1.1.0",
  "private": true,
  "description": "Editable Next.js App Router recreation of Run Rob Run",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src next.config.ts tsconfig.json README.md"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "lottie-web": "5.13.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
